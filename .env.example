# ---------------------------------------------------------------------------
# mars-777-police-agent — environment template (POLICE role)
#
# Copy to `.env` and fill in real values locally. `.env` is git-ignored;
# THIS file is committed and must never contain a real secret, a real token,
# a live public URL, or a private backend URL.
#
# Every name below is read exactly once, in
# `src/mars777_police/infra/settings.py`. No `app`, `domain` or `protocol`
# module consults the environment.
# ---------------------------------------------------------------------------

# Which role this process is. The package fixes the role of this repository,
# and boot refuses any value that disagrees — it cannot start as a thief.
MARS777_ROLE=police

# Where this agent listens. Bind to loopback for local play; the public route
# is published by the tunnel, never by binding a public interface directly.
MARS777_BIND_HOST=127.0.0.1
MARS777_BIND_PORT=8001

# The opponent's endpoint. Local two-process play uses a loopback address;
# a real match uses the counterparty's public URL, supplied at match time and
# never committed.
MARS777_OPPONENT_ENDPOINT=http://127.0.0.1:8002/mcp

# Keyed Step-0 / config authentication. `MARS777_KEY_ID` names the key; the
# secret itself is pre-shared out of band with the counterparty.
# PLACEHOLDER ONLY — replace locally, never commit the real value.
MARS777_KEY_ID=mars777-key-1
MARS777_AUTH_SECRET=replace-me-with-the-preshared-secret

# Where this process writes its own official artifacts.
MARS777_ARTIFACT_ROOT=./artifacts

# Opt-in gate for the live tunnel test suite. Those tests are skipped unless
# this is set to 1 and a real ngrok agent is installed.
MARS777_RUN_LIVE_NGROK=0

# ---------------------------------------------------------------------------
# Deliberately absent
#
# * ngrok credential — the agent never reads a tunnel token from the
#   environment or the command line. It uses the operator's own ngrok
#   configuration (`ngrok config add-authtoken …`), so the credential never
#   reaches this project's process arguments or logs.
# * Gmail / reporting variables — no reporting code exists yet. Names will be
#   added here by the slice that implements it; inventing them now would
#   publish a contract the code does not honour.
# ---------------------------------------------------------------------------
