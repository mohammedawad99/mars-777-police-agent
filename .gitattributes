# Default: normalize all detected text to LF inside the repository.
* text=auto eol=lf

# Explicit LF for source and config (protects canonical JSON byte-identity).
*.py    text eol=lf
*.pyi   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf

# Windows-only wrapper scripts keep CRLF (they contain no game logic).
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets: never convert line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
